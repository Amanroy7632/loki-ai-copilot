{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call only Loki's own commands. No core plugins, no shell, no filesystem, no HTTP. IPC channels need no extra permission.",
  "windows": ["main"],
  "permissions": [
    "allow-app-status",
    "allow-send-message",
    "allow-retry-reply",
    "allow-stop-reply",
    "allow-respond-approval",
    "allow-list-conversations",
    "allow-get-messages",
    "allow-rename-conversation",
    "allow-delete-conversation"
  ]
}
