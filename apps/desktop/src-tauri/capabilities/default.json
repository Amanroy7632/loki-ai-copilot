{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call only Loki's own commands. No core plugins, no dialog (the folder picker opens from Rust), no shell, no filesystem, no HTTP. IPC channels need no extra permission.",
  "windows": ["main"],
  "permissions": [
    "allow-app-status",
    "allow-send-message",
    "allow-retry-reply",
    "allow-stop-reply",
    "allow-respond-approval",
    "allow-list-conversations",
    "allow-get-messages",
    "allow-rename-conversation",
    "allow-delete-conversation",
    "allow-list-permissions",
    "allow-list-roots",
    "allow-grant-permission",
    "allow-revoke-permission",
    "allow-add-root",
    "allow-remove-root",
    "allow-get-settings",
    "allow-save-settings",
    "allow-clear-history",
    "allow-list-audit",
    "allow-export-data",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-voice-status",
    "allow-watch-voice",
    "allow-press-talk",
    "allow-release-talk",
    "allow-set-voice-muted"
  ]
}
